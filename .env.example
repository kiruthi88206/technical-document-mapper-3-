# Server Configuration
PORT=5000
HOST=0.0.0.0
FLASK_ENV=development
SECRET_KEY=change-this-in-production-secret-key-2026

# Database Configuration (Defaults to SQLite; update for PostgreSQL in production)
DATABASE_URL=sqlite:///instance/tech_mapper.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/tech_mapper

# Upload Limits & Paths
MAX_UPLOAD_SIZE_MB=25

# NLP Pipeline Tuning
MAX_TERMS_DEFAULT=40
MIN_TERM_FREQ=1
CONFIDENCE_THRESHOLD=0.35
CHUNK_SIZE_WORDS=350

# Optional External AI / LLM Integration (Not required for standard local NLP pipeline)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
